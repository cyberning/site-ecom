# Database — adaptez l'URL selon votre configuration PostgreSQL locale
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecom_dz?schema=public"

# NextAuth — générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_RUN_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials (for seed)
ADMIN_EMAIL="admin@ecom-dz.com"
ADMIN_PASSWORD="admin123"

# Pixel tokens (encrypted in DB, these are plain for initial setup)
META_PIXEL_ID=""
META_ACCESS_TOKEN=""
TIKTOK_PIXEL_CODE=""
TIKTOK_ACCESS_TOKEN=""

# Encryption key for pixel tokens (AES-256) — générer avec : openssl rand -hex 32
ENCRYPTION_KEY="CHANGE_ME_RUN_openssl_rand_hex_32"

# Upload config
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="E-Commerce DZ"
