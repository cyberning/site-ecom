// E-commerce DZ v2 — SQLite schema
// Lightweight schema for VPS deployment (1GB disk / 250MB RAM)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// User & Authentication
// ──────────────────────────────────────────────

/// Staff accounts: admins and call-agents who manage orders
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // role: ADMIN | CALL_AGENT
  role         String   @default("CALL_AGENT")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// ──────────────────────────────────────────────
// Catalog — Categories & Products
// ──────────────────────────────────────────────

/// Product categories (e.g. "Téléphones", "Accessoires")
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

/// Base product — holds shared info; variants hold SKU/price/stock
model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String   @default("")
  basePrice     Decimal  @default(0)
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  categoryId    String?
  seoTitle      String?
  seoDescription String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category  Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants  Variant[]
  images    ProductImage[]

  @@index([slug])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isActive])
  @@map("products")
}

/// A purchasable SKU: size / color / bundle etc.
model Variant {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  price     Decimal  @default(0)
  stock     Int      @default(0)
  productId String
  imageId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  image      ProductImage?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
  @@map("variants")
}

// ──────────────────────────────────────────────
// Product Images
// ──────────────────────────────────────────────

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String   @default("")
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  productId String
  createdAt DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants Variant[]

  @@map("product_images")
}

// ──────────────────────────────────────────────
// Orders
// ──────────────────────────────────────────────

/// A COD order placed by a customer
model Order {
  id               String   @id @default(cuid())
  trackingId       String   @unique
  customerName     String
  customerPhone    String
  customerPhoneHash String
  wilayaCode       Int
  communeCode      String
  fullAddress      String
  // deliveryMode: HOME | STOP_DESK
  deliveryMode     String   @default("HOME")
  subtotal         Decimal  @default(0)
  deliveryFee      Decimal  @default(0)
  total            Decimal  @default(0)
  // status: PENDING | CONFIRMED | SHIPPED | DELIVERED | CANCELLED | RETURNED
  status           String   @default("PENDING")
  notes            String?
  ip               String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items OrderItem[]

  @@index([trackingId])
  @@index([status])
  @@index([customerPhoneHash])
  @@index([wilayaCode])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int     @default(1)
  unitPrice Decimal @default(0)
  totalPrice Decimal @default(0)
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// ──────────────────────────────────────────────
// Delivery
// ──────────────────────────────────────────────

/// Per-wilaya delivery fee configuration
model DeliveryMatrix {
  id             String  @id @default(cuid())
  wilayaCode     Int     @unique
  wilayaName     String
  homeFee        Decimal @default(0)
  stopDeskFee    Decimal @default(0)
  estimatedDays  Int     @default(2)

  @@map("delivery_matrix")
}

// ──────────────────────────────────────────────
// Settings
// ──────────────────────────────────────────────

/// Key-value store for app settings (JSON-serialized values)
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  // category: general | theme | checkout | seo | analytics
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([category])
  @@map("settings")
}

// ──────────────────────────────────────────────
// Analytics (Airbyte-managed)
// ──────────────────────────────────────────────

/// Events pushed to Airbyte for analytics pipeline
model Analytics {
  id        String   @id @default(cuid())
  eventType String
  // source is always AIRBYTE for this project
  source    String   @default("AIRBYTE")
  payload   String   // JSON-serialized event data
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@map("analytics")
}

// ──────────────────────────────────────────────
// Geolocation — Wilayas & Communes
// ──────────────────────────────────────────────

/// Algerian wilayas (48 provinces) — PK is the official code
model Wilaya {
  code    Int    @id @default(0)
  name    String
  nameAr  String

  communes Commune[]

  @@map("wilayas")
}

model Commune {
  id        String @id @default(cuid())
  code      String @unique
  name      String
  nameAr    String
  wilayaCode Int

  wilaya Wilaya @relation(fields: [wilayaCode], references: [code])

  @@index([wilayaCode])
  @@map("communes")
}
