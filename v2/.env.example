DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="change-me-in-production"
# ⚠️ EN PRODUCTION : remplacez par le domaine réel du VPS, ex. https://shop.mondomaine.dz
# Sinon NextAuth générera des callback URLs vers localhost.
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@ecom-dz.com"
ADMIN_PASSWORD="admin123"
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"
# Secret partagé pour sécuriser le webhook /api/webhooks/airbyte (header x-webhook-secret)
AIRBYTE_WEBHOOK_SECRET="change-me-in-production"
